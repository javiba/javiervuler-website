{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(?<lang>fr|es|en).*" }],
      "destination": "/:lang/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/es/index.html",
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/fr/index.html",
      "destination": "/fr/",
      "permanent": true
    }
  ]
}
